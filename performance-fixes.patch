+
+/* ---------- Interaction feedback & navigation state ---------- */
+/* Remove the legacy 300ms tap delay and give every enabled button an immediate pressed state. */
+button, a[href], [role="button"], summary { touch-action: manipulation; }
+button:not(:disabled):active,
+.nav-link:active { scale: .975; }
+button:disabled { cursor: not-allowed; }
+.nav-link, button { -webkit-tap-highlight-color: rgb(124 92 255 / .18); }
+
+/* Top progress bar: starts in the same frame as the click (see NavigationProgress). */
+html[data-nav="loading"] body::before {
+  content: ""; position: fixed; top: 0; left: 0; z-index: 9999; height: 3px; width: 0;
+  background: linear-gradient(90deg, #7c5cff, #4f46e5, #22b8cf);
+  box-shadow: 0 0 10px rgb(124 92 255 / .6);
+  pointer-events: none;
+  animation: nav-progress 8s cubic-bezier(.1, .6, .2, 1) forwards;
+}
+@keyframes nav-progress { 0% { width: 0; } 12% { width: 35%; } 100% { width: 92%; } }
+
+/* In-button pending overlay (only shows if navigation takes longer than ~120ms). */
+.nav-pending { display: none; }
+.nav-pending[data-pending="true"] {
+  display: grid; place-items: center; position: absolute; inset: 0; border-radius: inherit;
+  background: rgb(15 23 42 / .22); pointer-events: none; opacity: 0;
+  animation: nav-pending-in .15s ease 120ms forwards;
+}
+.nav-pending[data-pending="true"]::after {
+  content: ""; width: 16px; height: 16px; border-radius: 999px;
+  border: 2px solid rgb(255 255 255 / .45); border-top-color: #fff;
+  animation: nav-spin .7s linear infinite;
+}
+@keyframes nav-pending-in { to { opacity: 1; } }
+@keyframes nav-spin { to { transform: rotate(360deg); } }
+
+/* Async-action spinner used inside submit/refresh buttons. */
+.btn-spinner {
