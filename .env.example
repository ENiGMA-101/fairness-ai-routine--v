# ============================================================================
# ClashOfPens — Server-Only Environment Variables (.env.example)
# ============================================================================
# SECURITY WARNING:
# Never commit real secrets or production credentials to Git.
# Never prefix DATABASE_URL, GOOGLE_CLIENT_SECRET, or SESSION_SECRET with VITE_.
# The browser must never connect directly to Neon PostgreSQL.

# Neon PostgreSQL Pooled Connection String (Server-Only)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Google OAuth 2.0 / OpenID Connect Configuration
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Application Session Signing Secret (minimum 32 random characters)
SESSION_SECRET="replace_with_32_byte_hex_or_base64_random_secret_key"

# Canonical Application Base URL (used for OAuth redirects and CSRF origin checks)
APP_URL="http://localhost:3000"
